# Smart Urban Tree Platform — Environment Variables
# Copy to .env and fill in your keys. NEVER commit .env to git.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_urban_tree
DB_USER=root
DB_PASSWORD=your_mysql_password

# IBM watsonx.ai
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key
IBM_PROJECT_ID=your_ibm_project_id
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# NASA Earthdata (AppEEARS)
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_token

# Sentinel Hub / Copernicus (optional)
SENTINEL_HUB_CLIENT_ID=your_sentinel_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_client_secret

# JWT Secret
JWT_SECRET_KEY=change_this_to_a_long_random_secret

# App
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change_this_flask_secret_key
